---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SectionIndex from "../components/ui/SectionIndex.astro";
import ScrollNav from "../components/ui/ScrollNav.astro";
import Hero from "../components/sections/Hero.astro";
import UpcomingCourse from "../components/sections/UpcomingCourse.astro";
import About from "../components/sections/About.astro";
import CourseArchive from "../components/sections/CourseArchive.astro";
import Education from "../components/sections/Education.astro";
import PantuCTA from "../components/sections/PantuCTA.astro";
import type { NavTabId } from "../data/navigation";
import { variantAt } from "../lib/sections";

// Orden de las secciones — única fuente de verdad. La variante bordó/blanco
// sale de la posición (variantAt), así que reordenar, agregar o sacar una
// sección mantiene la alternancia sola (BACKLOG.md §1). `nav` es la pestaña
// del índice que se resalta en esa sección; `label`, el texto accesible del
// link "siguiente sección" que apunta a ella. Sigue el mismo orden que las
// pestañas del índice (Cursos · Educación · Sobre nosotros, BACKLOG.md §9-10).
const sections: { id: string; Component: (props: any) => any; nav?: NavTabId; label: string }[] = [
	{ id: "hero", Component: Hero, label: "Ir al inicio" },
	{ id: "cursos", Component: UpcomingCourse, nav: "cursos", label: "Ir al próximo curso" },
	{ id: "nuestros-cursos", Component: CourseArchive, nav: "cursos", label: "Ir a nuestros cursos" },
	{ id: "educacion", Component: Education, nav: "educacion", label: "Ir a educación" },
	{ id: "sobre-nosotros", Component: About, nav: "sobre-nosotros", label: "Ir a sobre nosotros" },
	{ id: "pantu", Component: PantuCTA, label: "Ir a Pantu" },
];
---

<!-- One Page — orden de secciones según BRIEF.md §3. -->
<Layout>
	<Header />
	<SectionIndex />
	<ScrollNav />
	<main>
		<!-- Todas las secciones salvo Pantu son md:sticky top-0 (Section.astro):
		     efecto "cards", cada una tapada por la siguiente. Depende de que
		     TODAS compartan este mismo containing block, incluyendo Pantu aunque
		     Pantu misma NO sea sticky: su altura es la que le da a la anterior el
		     "tiempo" de scroll para quedar pegada antes de soltarse.

		     El Footer se deja AFUERA a propósito: es mucho más bajo que una
		     pantalla completa, así que si compartiera este límite, la última
		     sticky quedaría pegada mucho más allá de su propio final (el bug
		     original: Freud flotando sobre el Footer). Por la misma razón Pantu
		     nunca lleva sticky (ver su comentario).

		     Después de cada sección va un sentinel NO sticky (`<id>-end`), con
		     doble uso:
		     1) Header.astro y SectionIndex.astro los observan (no pueden observar
		        las secciones: al ser sticky siguen "intersectando" el viewport
		        durante casi todo el scroll aunque otras las tapen).
		     2) ScrollNav.astro usa el sentinel ANTERIOR a una sección como
		        destino real al navegar por hash, por el mismo motivo: una
		        sección ya pegada mide top:0 aunque esté tapada, y un ancla
		        nativa no movería el scroll. El sentinel siempre refleja su
		        posición real en el documento. -->
		<div class="relative">
			{
				sections.map(({ id, Component, nav }, index) => {
					const next = sections[index + 1];
					return (
						<>
							<Component id={id} variant={variantAt(index)} nav={nav} next={next && { id: next.id, label: next.label }} />
							<div id={`${id}-end`} data-section-sentinel class="h-px w-full" aria-hidden="true" />
						</>
					);
				})
			}
		</div>
	</main>
	<Footer />
</Layout>
