---
import { site } from "../../data/site";
---

<!-- BRIEF.md §01 — Hero/Identidad. TODO: CTA principal + 1-2 piezas de collage (DESIGN.md §6.1). -->
<section id="hero" class="flex min-h-screen flex-col items-center justify-center gap-6 bg-white px-6 py-24 text-center">
	<h1 class="font-identity max-w-[20ch] text-[clamp(1.5rem,4.5vw,2.5rem)] font-black text-carbon-black uppercase">
		{site.name}
	</h1>
	<p class="font-editorial max-w-[45ch] text-base text-carbon-black/70">
		{site.tagline}
	</p>
</section>
