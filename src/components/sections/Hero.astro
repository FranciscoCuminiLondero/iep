---
import { site } from "../../data/site";
import type { SectionProps } from "../../lib/sections";
import Section from "../layout/Section.astro";
import FigureCutout from "../collage/FigureCutout.astro";
import NextSectionLink from "../ui/NextSectionLink.astro";

type Props = SectionProps;

const { id, variant, nav, next } = Astro.props;

// Mismo tamaño para el h1 y para hero.png (ver comentario del markup).
// Baja de forma progresiva con el ancho: ~26px a 320px, tope 56px.
const titleSize = "text-[clamp(1.375rem,0.75rem+4.5vw,3.5rem)]";
---

<!-- BRIEF.md §01 — Hero/Identidad. TODO: CTA principal (DESIGN.md §6.1). -->
<!-- Responsive sin solapamientos (BACKLOG.md §7): todo va en flujo normal,
     nada absolute salvo la flecha. El texto se centra en el espacio libre
     (flex-1) y hero.png queda pegada abajo, DESPUÉS del texto — si la
     pantalla es baja (o hay zoom), la sección crece en vez de que la imagen
     tape el texto. Antes hero.png era absolute bottom-0 y en pantallas bajas
     se montaba sobre el texto.

     hero.png va al doble de ancho que el título — max-w-[40ch] solo da ese
     resultado si comparte fuente Y tamaño con el h1, porque "ch" se calcula
     a partir de ambos; por eso repite font-title y titleSize (sin efecto
     visual en un <img>, solo para que el cálculo dé igual). Tope de 110vh
     de ancho (~32vh de alto, por la proporción 931x268): en pantallas
     anchas y bajas la imagen no empuja al Hero más allá de una pantalla.
     PNG sin fondo: se ve solo el recorte, directo sobre el bordó.

     El padding de arriba suma el alto de la barra de navegación fija
     (SectionIndex.astro), así nunca tapa el logo ni el título — en todos
     los tamaños: mientras se ve el Hero la barra está arriba también en
     escritorio. Hero no lleva el margen de la columna lateral (railOffset):
     ocupa todo el ancho. -->
<Section id={id} variant={variant} nav={nav} railOffset={false} class="flex min-h-screen flex-col items-center px-6 pt-[calc(var(--nav-bar-h)+2rem)] text-center">
	<div class="flex flex-1 flex-col items-center justify-center gap-4 pb-8">
		{/* TODO: reemplazar por el logo en SVG o PNG con fondo transparente
		    cuando lo tengamos (BACKLOG.md D) — hoy solo existe este JPG
		    cuadrado, que se recorta en círculo con rounded-full + object-cover.
		    El anillo blanco marca el borde del círculo: el fondo del JPG es
		    bordó, igual que el del Hero. */}
		<img
			src="/images/logo-iep.jpg"
			alt={site.name}
			class="size-[clamp(5.5rem,4rem+8vw,9rem)] shrink-0 rounded-full object-cover ring-2 ring-white/80"
		/>
		<h1 class:list={["font-title max-w-[20ch] leading-[1.05] font-black text-balance break-words text-fg uppercase", titleSize]}>
			{site.longName}
		</h1>
		<p class="font-body text-sm font-bold text-fg/70">{site.founders}</p>
		<p class="font-body max-w-[45ch] text-base text-fg/70">{site.tagline}</p>
		<p class="font-body text-xs text-fg/70">{site.decree}</p>
	</div>
	<FigureCutout
		src="/images/hero.png"
		alt="Collage de escritores y pensadores en blanco y negro"
		class:list={["font-title w-[min(100%,40ch,110vh)]", titleSize]}
	/>
	{next && <NextSectionLink target={next.id} label={next.label} />}
</Section>
