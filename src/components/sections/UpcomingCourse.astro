---
import { courseRepository } from "../../lib/courses/local.repository";
import { site } from "../../data/site";
import FigureCutout from "../collage/FigureCutout.astro";
import CollagePiece from "../collage/CollagePiece.astro";
import NextSectionLink from "../ui/NextSectionLink.astro";
import { MessageCircle } from "lucide-astro";
import type { SectionProps } from "../../lib/sections";
import Section from "../layout/Section.astro";
import { courseSignupMessage, whatsappUrl } from "../../lib/whatsapp/messages";

type Props = SectionProps;

const { id, variant, nav, next } = Astro.props;

const course = await courseRepository.getUpcoming();

const whatsappHref =
	course && site.whatsappPhone
		? whatsappUrl(course.whatsappMessage ?? courseSignupMessage(course))
		: undefined;
---

<!-- BRIEF.md §02 — Próximo curso: pieza protagonista, tratamiento de afiche (DESIGN.md §6.2). -->
<!-- TODO: reemplazar este placeholder por el tratamiento tipo afiche/editorial completo. -->
<!-- Layout de dos columnas desde lg: flyer (recuadro) a la izquierda,
     texto a la derecha. El título mostrado es course.title (el nombre
     real del curso), no course.hook. lg:sticky lg:top-0: efecto "cards" al
     pasar de sección (la siguiente sube y tapa esta mientras queda
     pegada).

     Sin wrapper individual — a propósito, ver comentario en Hero.astro:
     el containing block de este sticky es el wrapper que agrupa las cinco
     secciones "cards" en index.astro, necesario para que cada una quede
     tapada por la siguiente.

     SOLO desde md — ver comentario en Hero.astro: en mobile esta sección
     apila flyer + texto en columna y puede superar el alto de pantalla
     (medido 1058px contra ~842px con Lacan, antes de que pasara a "Sobre
     nosotros"); con sticky, el botón de WhatsApp
     (más abajo del todo) no se vuelve alcanzable hasta un tramo de scroll
     enorme, para cuando la sección siguiente ya la tapó.

     Fila y sticky recién desde lg (no md): entre 768 y 1023px la fila no
     entraba (menos todavía con la columna
     del índice a la izquierda) — se cortaban por los dos costados. En ese
     rango va apilada y sin sticky, igual que en mobile. -->
<Section id={id} variant={variant} nav={nav} sticky="lg" class="flex min-h-screen flex-col items-center justify-center gap-10 px-6 py-20 text-center lg:flex-row lg:gap-16 lg:text-left">
	{
		course ? (
			<>
				{course.flyer && (
					// Recuadro con el flyer completo del curso — CollagePiece porque acá sí
					// se quiere mostrar entero y legible (zoom=1, aspect-ratio real del
					// afiche), a diferencia de la figura-recorte de la derecha.
					<CollagePiece
						src={course.flyer}
						alt={`Flyer del curso "${course.title}"`}
						rotation={-3}
						class="aspect-[404/505] w-48 shrink-0 sm:w-56 md:w-64"
					/>
				)}

				<div class="relative isolate flex max-w-md flex-col items-center gap-4 lg:items-start">
					<p class="font-body text-xs font-bold tracking-[0.1em] text-accent uppercase">Próximo curso</p>
					<h2 class="font-body text-[clamp(1.75rem,6vw,3.25rem)] leading-[1.05] font-black text-fg">
						{course.title}
					</h2>
					{(course.date || course.modality) && (
						<p class="font-body text-sm font-bold text-fg/70">
							{[course.date, course.modality].filter(Boolean).join(" · ")}
						</p>
					)}
					<p class="font-body text-base text-fg/70">{course.description}</p>
					<a
						href={whatsappHref ?? "#"}
						class="font-body flex items-center gap-2 rounded-full bg-carbon-black px-6 py-3 text-sm font-bold text-white"
					>
						{/* MessageCircle, no el logo de WhatsApp: ver comentario del mismo
						    ícono en PantuCTA.astro — Lucide no trae logos de marca. */}
						<MessageCircle class="h-4 w-4" aria-hidden="true" />
						Quiero anotarme
					</a>

					{course.image && (
						// Figura relacionada al tema del curso, tomada del propio contenido
						// (DESIGN.md §6.2). Patrón "personaje-recorte" (no CollagePiece): se ve
						// completa, sin rotación ni sombra. Pegada al borde derecho de esta
						// columna de texto (left-full) desde lg — en mobile/tablet "left-full"
						// no tiene sentido (una sola columna, angosta): en vez de eso queda
						// chica, en la esquina inferior derecha de esta MISMA columna, con
						// -z-10 (igual que Freud/Bauman/libros) para quedar detrás del texto
						// si se solapa en vez de taparlo. Visible en todos los tamaños (sin
						// `hidden`). El div de esta columna lleva `isolate` (ver clase, más
						// abajo) para que ese -z-10 no se escape al contexto raíz de la
						// página — misma explicación que el comentario de Freud en
						// About.astro.
						<FigureCutout
							src={course.image}
							alt={`Figura relacionada con "${course.title}"`}
							class="absolute right-0 bottom-0 -z-10 h-20 sm:h-28 lg:top-0 lg:right-auto lg:bottom-auto lg:left-full lg:z-auto lg:h-[50vh]"
						/>
					)}
				</div>
			</>
		) : (
			<>
				{/* Sin curso con inscripción abierta: mismo mensaje que el menú del
				    bot de WhatsApp ("📅 Nuevos cursos en 2027."), con Lacan como
				    figura de la sección. */}
				<FigureCutout
					src="/images/lacan.png"
					alt="Jacques Lacan"
					class="h-[22vh] shrink-0 sm:h-[36vh] md:h-[42vh] lg:h-[46vh]"
				/>
				<div class="flex max-w-md flex-col items-center gap-4 lg:items-start">
					<p class="font-body text-xs font-bold tracking-[0.1em] text-accent uppercase">Próximo curso</p>
					<h2 class="font-body text-[clamp(1.75rem,6vw,3.25rem)] leading-[1.05] font-black text-fg">
						Nuevos cursos en 2027
					</h2>
					<p class="font-body text-base text-fg/70">Mientras tanto, podés recorrer los cursos ya dictados.</p>
					<a href="#nuestros-cursos" class="font-body text-sm font-bold text-accent underline underline-offset-2">Ver cursos dictados</a>
				</div>
			</>
		)
	}
	{next && <NextSectionLink target={next.id} label={next.label} />}
</Section>
