---
import { site } from "../../data/site";
import { navTabs } from "../../data/navigation";

// Mismas pestañas que el índice de secciones (SectionIndex.astro), más Inicio.
const navLinks = [{ label: "Inicio", href: "#hero" }, ...navTabs.map((tab) => ({ label: tab.label, href: `#${tab.id}` }))];
---

<!-- BRIEF.md §06 — Cierre. Fondo bordó fijo: no entra en la alternancia
     de secciones (index.astro), es un cierre acotado, no una sección de
     contenido. Sin CTA de WhatsApp: el de Pantu, arriba, ya cumple esa
     función (BRIEF.md §23 — evitar que el botón verde/CTA se repita como si
     fuera el color dominante). Solo logo + navegación + contacto. -->
<footer id="contacto" class="flex flex-col items-center gap-6 bg-bitter-chocolate px-6 py-12 text-center">
	<a href="#hero" aria-label={`Volver arriba — ${site.name}`}>
		<img src="/images/logo-iep.jpg" alt={site.name} class="h-10 w-10 rounded-sm" />
	</a>
	<nav aria-label="Secciones" class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
		{
			navLinks.map((link) => (
				<a href={link.href} class="font-body text-sm text-white/70 transition-colors hover:text-white">
					{link.label}
				</a>
			))
		}
	</nav>
	<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
		<a href={site.instagramUrl} target="_blank" rel="noopener" class="font-body text-sm text-white/70 transition-colors hover:text-white">
			{site.instagramHandle}
		</a>
		{
			site.whatsappPhone && (
				<a
					href={`https://wa.me/${site.whatsappPhone}`}
					target="_blank"
					rel="noopener"
					class="font-body text-sm text-white/70 transition-colors hover:text-white"
				>
					+{site.whatsappPhone}
				</a>
			)
		}
	</div>
</footer>
