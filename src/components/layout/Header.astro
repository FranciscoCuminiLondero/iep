---
import { site } from "../../data/site";
---

<!-- El logo del Hero (Hero.astro) ya cubre la identidad en el primer scroll.
     Este vuelve a aparecer, fijo arriba, recién cuando el Hero sale del
     viewport — funciona como "volver arriba", no como nav permanente.
     IntersectionObserver sobre #hero: es la misma lógica de revelado que
     propone ARCHITECTURE.md §22 (IntersectionObserver → estado → CSS), acá
     resuelta inline por ser un caso puntual de un solo componente.
     rootMargin recorta el 50% SUPERIOR del área de detección, dejando como
     "root" solo la mitad de abajo del viewport — el Hero deja de
     intersectarla (dispara el cambio) apenas su borde inferior sube por
     encima de la mitad de la pantalla, sin esperar a que salga del todo
     (con min-h-screen, si el contenido es más bajo que la pantalla queda un
     relleno vacío que si no hay que scrollear de más). Ojo si se vuelve a
     tocar: recortar el margen INFERIOR en vez del superior invierte la
     lógica (deja como "root" la mitad de ARRIBA) y el bug vuelve.

     También se oculta apenas aparece el Footer (#contacto): el Footer ya
     tiene su propio logo, y como los dos usan el mismo bordó de fondo, el
     logo flotante quedaba ahí como un parche de color sin sentido — nada
     roto en la imagen, solo un elemento redundante mostrándose donde no
     hace falta. -->

<header
	id="site-header"
	data-visible="false"
	class="pointer-events-none fixed inset-x-0 top-0 z-20 flex items-center justify-center py-4 opacity-0 transition-opacity duration-300 data-[visible=true]:pointer-events-auto data-[visible=true]:opacity-100"
>
	<a href="#hero" aria-label={`Volver arriba — ${site.name}`}>
		<img src="/images/logo-iep.jpg" alt={site.name} class="h-10 w-10 rounded-sm" />
	</a>
</header>

<script>
	const header = document.getElementById("site-header");
	const hero = document.getElementById("hero");
	const footer = document.getElementById("contacto");

	if (header && hero && footer) {
		let heroVisible = true;
		let footerVisible = false;

		const updateVisibility = () => {
			header.dataset.visible = heroVisible || footerVisible ? "false" : "true";
		};

		const heroObserver = new IntersectionObserver(
			([entry]) => {
				heroVisible = entry.isIntersecting;
				updateVisibility();
			},
			{ threshold: 0, rootMargin: "-50% 0px 0px 0px" },
		);
		heroObserver.observe(hero);

		// Sin rootMargin acá: apenas asome cualquier parte del Footer, se
		// oculta — no hace falta esperar a que se vea la mitad.
		const footerObserver = new IntersectionObserver(
			([entry]) => {
				footerVisible = entry.isIntersecting;
				updateVisibility();
			},
			{ threshold: 0 },
		);
		footerObserver.observe(footer);
	}
</script>
