---
// Índice de secciones (BACKLOG.md §8-9): 3 pestañas rectangulares, fondo
// bordó, texto blanco. Un solo <nav> con dos formatos:
//   - ≥768px: columna fija a la izquierda, a toda altura. Ocupa su propio
//     ancho (global.css le reserva --nav-rail-w con padding-left en body),
//     así nunca tapa contenido.
//   - <768px: barra fija arriba, de alto --nav-bar-h, para no sacarle ancho
//     al contenido. El Hero suma ese alto a su padding de arriba y las
//     secciones lo usan de scroll-margin-top (Section.astro).
// Siempre visible, también sobre el Hero (reemplaza al menú hamburguesa
// mobile y al índice flotante anterior, que se ocultaban en el Hero).
//
// La pestaña de la sección que se está viendo lleva aria-current (ver
// script). La navegación por click la resuelve ScrollNav.astro.
import { navTabs } from "../../data/navigation";
---

<nav
	id="section-index"
	aria-label="Secciones de la página"
	class="fixed inset-x-0 top-0 z-30 h-(--nav-bar-h) border-b border-white/20 bg-bitter-chocolate md:inset-x-auto md:bottom-0 md:left-0 md:h-auto md:w-(--nav-rail-w) md:border-r md:border-b-0"
>
	<ul class="flex h-full md:flex-col md:justify-center md:gap-1 md:px-3">
		{
			navTabs.map((tab) => (
				<li class="flex flex-1 md:flex-none">
					<a
						href={`#${tab.id}`}
						data-tab={tab.id}
						class="font-body flex w-full items-center justify-center px-2 text-center text-[clamp(0.6875rem,3.2vw,0.875rem)] leading-tight font-bold tracking-[0.04em] text-white uppercase transition-colors outline-current hover:bg-white/10 focus-visible:outline-2 focus-visible:-outline-offset-4 aria-[current=location]:bg-white aria-[current=location]:text-bitter-chocolate md:justify-start md:px-4 md:py-4 md:text-left md:text-base"
					>
						{tab.label}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<script>
	// Resalta la pestaña de la sección que se está viendo. Cada sección
	// arranca justo después del sentinel de la anterior (index.astro); se
	// observan esos sentinels y no las secciones, porque desde md las
	// secciones son sticky y siguen "intersectando" el viewport aunque otra
	// las tape (mismo motivo que en Header.astro y ScrollNav.astro).
	//
	// rootMargin: el área de detección va desde muy arriba de la página hasta
	// el 40% del viewport. Un sentinel "intersecta" mientras está por encima
	// de esa línea — o sea, mientras su sección ya empezó. Cubrir todo lo de
	// arriba (no solo una franja) hace que un salto largo de scroll también
	// dispare el cambio. La sección actual es la última que ya empezó.
	const nav = document.getElementById("section-index");
	const links = nav ? [...nav.querySelectorAll<HTMLAnchorElement>("a[data-tab]")] : [];
	const sections = [...document.querySelectorAll<HTMLElement>("[data-section]")];

	if (links.length > 0 && sections.length > 0 && "IntersectionObserver" in window) {
		const started = new Set<HTMLElement>([sections[0]]);
		const sectionByMarker = new Map<Element, HTMLElement>();

		for (const section of sections.slice(1)) {
			const marker = section.previousElementSibling;
			if (marker?.hasAttribute("data-section-sentinel")) sectionByMarker.set(marker, section);
		}

		const updateActive = () => {
			const current = sections.findLast((section) => started.has(section));
			const tab = current?.dataset.nav;
			for (const link of links) {
				if (tab && link.dataset.tab === tab) link.setAttribute("aria-current", "location");
				else link.removeAttribute("aria-current");
			}
		};

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const section = sectionByMarker.get(entry.target);
					if (!section) continue;
					if (entry.isIntersecting) started.add(section);
					else started.delete(section);
				}
				updateActive();
			},
			{ rootMargin: "100000px 0px -60% 0px", threshold: 0 },
		);

		sectionByMarker.forEach((_, marker) => observer.observe(marker));
		updateActive();
	}
</script>
