---
// Sin markup propio — solo el script de abajo. Centraliza la navegación por
// hash a las secciones de la página para TODOS los links que apuntan a ellas
// (SectionIndex, el logo de Header/Footer, NextSectionLink, el Footer) sin
// tener que tocar cada componente: delega el click a nivel de document. Se
// aplica a cualquier elemento con data-section (Section.astro), así que las
// secciones nuevas quedan cubiertas sin registrarlas acá.
//
// Por qué hace falta (no alcanza con dejarlo en manos del navegador):
// desde md las secciones son sticky (efecto "cards", ver index.astro) — una
// vez que una ya quedó pegada en top:0, su propio getBoundingClientRect().top
// da 0 aunque una sección posterior la tape en pantalla. Un <a href="#id">
// plano hace que el navegador la vea "ya visible" y no mueva el scroll: falla
// en silencio al volver a una sección ya pasada. El destino real es el
// sentinel que está justo antes de cada sección (index.astro): no es sticky,
// así que siempre refleja la posición real en el documento.
//
// También descuenta el scroll-margin-top de la sección (en mobile, el alto de
// la barra de navegación fija — Section.astro). La animación es la de
// lib/scroll.ts (duración según distancia, sin animación con
// prefers-reduced-motion).
//
// Avisa el inicio y el fin de cada navegación con los eventos
// "section-nav:start" (detail: la sección de destino) y "section-nav:end":
// SectionIndex.astro fija la pestaña de destino mientras dura el scroll, en
// vez de ir resaltando cada sección intermedia que pasa (el parpadeo).
---

<script>
	import { smoothScrollTo } from "../../lib/scroll";

	document.addEventListener("click", (event) => {
		const target = event.target;
		if (!(target instanceof Element)) return;
		const link = target.closest("a[href^='#']");
		if (!link) return;

		const id = link.getAttribute("href")?.slice(1);
		const section = id ? document.getElementById(id) : null;
		if (!section?.hasAttribute("data-section")) return; // no es una sección: comportamiento nativo

		event.preventDefault();

		// Sin sentinel antes = primera sección, tope real de la página.
		const marker = section.previousElementSibling;
		const sectionTop = marker?.hasAttribute("data-section-sentinel") ? marker.getBoundingClientRect().bottom + window.scrollY : 0;
		const offset = parseFloat(getComputedStyle(section).scrollMarginTop) || 0;

		document.dispatchEvent(new CustomEvent("section-nav:start", { detail: section }));
		smoothScrollTo(Math.max(0, sectionTop - offset), () => document.dispatchEvent(new CustomEvent("section-nav:end")));
		history.pushState(null, "", `#${id}`);
		// Para teclado y lectores de pantalla: el foco sigue desde la sección
		// de destino, como haría un ancla nativa.
		section.focus({ preventScroll: true });
	});
</script>
